{
  "config": {
    "step": {
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "connector_id": "Connector ID",
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "host": "The hostname or IP address of the K1 connector in your local network.",
          "port": "The UDP port of the K1 connector. The default port 1025 works in most cases.",
          "username": "Optional. The account of the Elro Connects app. It is only used during setup, to get the connector ID and API key from the cloud.",
          "password": "Optional. The password of the Elro Connects app account.",
          "connector_id": "The ID of the connector, which starts with ST_. In the Elro Connects app, go to the home tab, open the settings and select current connector. Not needed if you log in with your account.",
          "api_key": "Optional. Only needed if the connector does not provide the key locally. It is filled in automatically if you log in with your account."
        }
      },
      "reconfigure": {
        "data": {
          "host": "[%key:component::elro_connects::config::step::user::data::host%]",
          "port": "[%key:component::elro_connects::config::step::user::data::port%]",
          "username": "[%key:component::elro_connects::config::step::user::data::username%]",
          "password": "[%key:component::elro_connects::config::step::user::data::password%]",
          "connector_id": "[%key:component::elro_connects::config::step::user::data::connector_id%]",
          "api_key": "[%key:component::elro_connects::config::step::user::data::api_key%]"
        },
        "data_description": {
          "host": "[%key:component::elro_connects::config::step::user::data_description::host%]",
          "port": "[%key:component::elro_connects::config::step::user::data_description::port%]",
          "username": "[%key:component::elro_connects::config::step::user::data_description::username%]",
          "password": "[%key:component::elro_connects::config::step::user::data_description::password%]",
          "connector_id": "[%key:component::elro_connects::config::step::user::data_description::connector_id%]",
          "api_key": "[%key:component::elro_connects::config::step::user::data_description::api_key%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "entity": {
    "sensor": {
      "device_state": {
        "name": "Device state",
        "state": {
          "normal": "Normal",
          "alarm": "Alarm",
          "fire_alarm": "Fire alarm",
          "test_alarm": "Test alarm",
          "fault": "Fault",
          "silence": "Silence",
          "unknown": "Unknown",
          "offline": "Offline",
          "open": "Open",
          "closed": "Closed",
          "low_battery": "Low battery",
          "temperature_alarm": "Temperature alarm"
        }
      },
      "battery": {
        "name": "Battery"
      },
      "signal": {
        "name": "Signal"
      }
    },
    "siren": {
      "alarm_co": {
        "name": "Test alarm"
      },
      "alarm_fire": {
        "name": "Test alarm"
      },
      "alarm_heat": {
        "name": "Test alarm"
      },
      "alarm_smoke": {
        "name": "Test alarm"
      },
      "alarm_water": {
        "name": "Test alarm"
      }
    },
    "switch": {
      "socket": {
        "name": "Socket"
      }
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "Could not send the command to the K1 connector: {error}"
    }
  }
}
